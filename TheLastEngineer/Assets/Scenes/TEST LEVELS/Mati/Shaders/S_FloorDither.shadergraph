{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "6ed644d716cc55fd6f060449711b9e8f",
    "m_Title": "Dither transparency",
    "m_Content": "Opaco + Alpha Clip: el umbral de clip sale de una matriz Bayer 4x4 en pantalla (Dither con In=1), asi no pasa por la cola transparente (sin sorting, escribe depth, proyecta sombra).\nAlpha = MainTex.A * Opacity * mask.\nmask = lerp(1, hole, inFront * _DitherCenter.w): hole es un circulo en pantalla centrado en _DitherCenter.xy (radio _DitherRadius, borde _DitherFalloff, corregido por aspect); inFront recorta solo lo que esta entre la camara y _PlayerPos.\n_DitherCenter y _PlayerPos son GLOBALES (no expuestas): las setea PlayerDither cada frame.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1275.0,
        "y": 54.0,
        "width": 420.0,
        "height": 220.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

